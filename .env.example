# Public frontend variables. Never put credentials or PHI secrets in VITE_* variables.
VITE_APP_NAME="Remote Patient Monitoring"

# Browser key for Places Autocomplete (New). Enable Maps JavaScript API and Places API (New).
# Restrict this public key to your app domains using HTTP referrer restrictions.
VITE_GOOGLE_MAPS_API_KEY=

# Shared HTTP API root. Resource paths are defined in services.
VITE_API_BASE_URL=https://rl9otvtzf6.execute-api.eu-north-1.amazonaws.com/api

# Realtime readings use a separate WebSocket host.
VITE_READINGS_WEBSOCKET_URL=wss://tggrlk6xmd.execute-api.eu-north-1.amazonaws.com/production

# Public VAPID application-server key (base64url). Optional until the push backend is ready.
# Never put the VAPID private key in frontend environment variables.
VITE_WEB_PUSH_PUBLIC_KEY=

# Server-only keys for RPM AI summaries. Set in .env.local for Vite or in the hosting environment.
OPENAI_API_KEY=
OPENAI_RPM_MODEL=gpt-5-mini
